#!/bin/bash

# omarchy:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# omarchy:args=<packages...>

pkg_installed() {
  local pkg=$1
  rpm -q -- "$pkg" &>/dev/null && return 0
  case "$pkg" in
    brave-bin) rpm -q brave-browser &>/dev/null && return 0 ;;
    brave-origin-bin) rpm -q brave-origin-browser &>/dev/null && return 0 ;;
    microsoft-edge-stable-bin) rpm -q microsoft-edge-stable &>/dev/null && return 0 ;;
    zen-browser-bin) rpm -q zen-browser &>/dev/null && return 0 ;;
    google-chrome)
      rpm -q google-chrome-stable &>/dev/null && return 0
      flatpak info com.google.Chrome &>/dev/null && return 0
      ;;
    visual-studio-code-bin) rpm -q code &>/dev/null && return 0 ;;
    sublime-text-4) rpm -q sublime-text &>/dev/null && return 0 ;;
    libreoffice-fresh) rpm -q libreoffice-writer &>/dev/null && return 0 ;;
    github-cli) rpm -q gh &>/dev/null && return 0 ;;
    mise-bin) rpm -q mise &>/dev/null && return 0 ;;
    nordvpn-bin) rpm -q nordvpn &>/dev/null && return 0 ;;
    libfprint-git) rpm -q libfprint &>/dev/null && return 0 ;;
    voxtype-bin) rpm -q voxtype &>/dev/null && return 0 ;;
    voxtype) rpm -q voxtype-bin &>/dev/null && return 0 ;;
    python-terminaltexteffects) rpm -q ttfx &>/dev/null && return 0 ;;
    libpulse) rpm -q pulseaudio-libs &>/dev/null && return 0 ;;
    vulkan-intel | vulkan-radeon | vulkan-freedreno) rpm -q mesa-vulkan-drivers &>/dev/null && return 0 ;;
    lib32-vulkan-intel | lib32-vulkan-radeon) rpm -q mesa-vulkan-drivers.i686 &>/dev/null && return 0 ;;
    sof-firmware) rpm -q alsa-sof-firmware &>/dev/null && return 0 ;;
    pipewire-libcamera) rpm -q pipewire-plugin-libcamera &>/dev/null && return 0 ;;
    pipewire-pulse) rpm -q pipewire-pulseaudio &>/dev/null && return 0 ;;
    pipewire-jack) rpm -q pipewire-jack-audio-connection-kit &>/dev/null && return 0 ;;
    gst-plugin-pipewire) rpm -q pipewire-gstreamer &>/dev/null && return 0 ;;
    pam-u2f) rpm -q pam_u2f &>/dev/null && return 0 ;;
    broadcom-wl-dkms) rpm -q broadcom-wl &>/dev/null && return 0 ;;
    v4l2loopback-dkms) rpm -q v4l2loopback &>/dev/null && return 0 ;;
    obsidian) flatpak info md.obsidian.Obsidian &>/dev/null && return 0 ;;
    *.*.*) flatpak info -- "$pkg" &>/dev/null && return 0 ;;
  esac
  return 1
}

for pkg in "$@"; do
  pkg_installed "$pkg" || exit 1
done

exit 0
