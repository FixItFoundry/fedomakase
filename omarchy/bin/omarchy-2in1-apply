#!/bin/bash

# omarchy:summary=Apply a 2-in-1 mode to the session's devices
# omarchy:args=[tablet|laptop]
# omarchy:hidden=true

# Raises one mode on the session. Tablet mode kills the touchpad and
# silences the built-in keyboard; laptop mode restores both and rotates the
# screen upright.

MODE="${1:-}"
[[ $MODE == tablet || $MODE == laptop ]] || { echo "Usage: omarchy-2in1-apply [tablet|laptop]" >&2; exit 1; }

set_device_enabled() {
  local name="$1" enabled="$2" quoted
  [[ -n $name ]] || return 0
  quoted=${name//\\/\\\\}
  quoted=${quoted//\"/\\\"}
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = $enabled })" >/dev/null
}

if [[ $MODE == "tablet" ]]; then
  enabled=false
else
  enabled=true
fi

set_device_enabled "$(omarchy-hw-touchpad)" "$enabled"
set_device_enabled "$(omarchy-hw-keyboard)" "$enabled"
# keyd forwards the built-in keyboard through a separate virtual device.
while IFS= read -r name; do
  set_device_enabled "$name" "$enabled"
done < <(hyprctl devices -j | jq -r '.keyboards[] | select(.name == "keyd-virtual-keyboard") | .name')

omarchy-2in1-rotate auto >/dev/null 2>&1 || true
