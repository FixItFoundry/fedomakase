#!/bin/bash

# omarchy:summary=Install Fedora RPM or Flatpak packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

map_pkg() {
  case "$1" in
    brave-bin) echo brave-browser ;;
    brave-origin-bin) echo brave-origin-browser ;;
    microsoft-edge-stable-bin) echo microsoft-edge-stable ;;
    zen-browser-bin) echo zen-browser ;;
    google-chrome) echo google-chrome-stable ;;
    visual-studio-code-bin) echo code ;;
    sublime-text-4) echo sublime-text ;;
    libreoffice-fresh) echo libreoffice-writer ;;
    github-cli) echo gh ;;
    mise-bin) echo mise ;;
    nordvpn-bin) echo nordvpn ;;
    libfprint-git) echo libfprint ;;
    wine-staging) echo wine ;;
    python-protobuf) echo python3-protobuf ;;
    python-gpgme) echo python3-gpg ;;
    python-terminaltexteffects) echo ttfx ;;
    libpulse) echo pulseaudio-libs ;;
    vulkan-intel | vulkan-radeon | vulkan-freedreno) echo mesa-vulkan-drivers ;;
    lib32-vulkan-intel | lib32-vulkan-radeon) echo mesa-vulkan-drivers.i686 ;;
    lib32-nvidia-utils | lib32-nvidia-580xx-utils) echo xorg-x11-drv-nvidia-libs.i686 ;;
    intel-media-driver) echo libva-intel-media-driver ;;
    libva-intel-driver) echo intel-vaapi-driver ;;
    vpl-gpu-rt) echo intel-vpl-gpu-rt ;;
    sof-firmware) echo alsa-sof-firmware ;;
    pipewire-libcamera) echo pipewire-plugin-libcamera ;;
    pipewire-pulse) echo pipewire-pulseaudio ;;
    pipewire-jack) echo pipewire-jack-audio-connection-kit ;;
    gst-plugin-pipewire) echo pipewire-gstreamer ;;
    pam-u2f) echo pam_u2f ;;
    broadcom-wl-dkms) echo broadcom-wl ;;
    v4l2loopback-dkms) echo v4l2loopback ;;
    ffmpeg) echo ffmpeg-free ;;
    docker) echo moby-engine ;;
    fd) echo fd-find ;;
    nvim) echo neovim ;;
    vim) echo vim-enhanced ;;
    tobi-try) echo try ;;
    imagemagick) echo ImageMagick ;;
    networkmanager) echo NetworkManager ;;
    python-gobject) echo python3-gobject ;;
    python-poetry-core) echo python3-poetry-core ;;
    tesseract-data-eng) echo tesseract-langpack-eng ;;
    woff2-font-awesome | fontawesome-fonts) echo fontawesome-fonts-web ;;
    openbsd-netcat) echo nmap-ncat ;;
    *) echo "$1" ;;
  esac
}

mapped=()
for pkg in "$@"; do
  # Skip obsidian if not available as RPM and not installed via Flatpak
  if [[ $pkg == "obsidian" ]] && ! dnf repoquery --qf '%{name}' obsidian 2>/dev/null | grep -qx obsidian; then
    if omarchy-cmd-present flatpak && flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
      flatpak install -y flathub md.obsidian.Obsidian || true
    fi
    continue
  fi
  mapped+=("$(map_pkg "$pkg")")
done

if (( ${#mapped[@]} > 0 )) && omarchy-pkg-missing "${mapped[@]}"; then
  run_root() { if (( EUID == 0 )); then "$@"; else sudo "$@"; fi; }
  for m in "${mapped[@]}"; do
    case "$m" in
      google-chrome-stable)
        if [[ -f /etc/yum.repos.d/google-chrome.repo ]]; then
          run_root sed -i 's/enabled=0/enabled=1/g' /etc/yum.repos.d/google-chrome.repo 2>/dev/null || true
        fi
        ;;
      steam)
        if [[ -f /etc/yum.repos.d/rpmfusion-nonfree-steam.repo ]]; then
          run_root sed -i '0,/enabled=0/s/enabled=0/enabled=1/' /etc/yum.repos.d/rpmfusion-nonfree-steam.repo 2>/dev/null || true
        fi
        ;;
    esac
  done
  run_root dnf install -y -- "${mapped[@]}" || exit 1
fi

for pkg in "${mapped[@]}"; do
  if ! omarchy-pkg-present "$pkg"; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
