#!/bin/bash

# omarchy:summary=Rotate the built-in display for the 2-in-1's current mode
# omarchy:args=[portrait|landscape|auto]
# omarchy:hidden=true

# Without an accelerometer the only orientation the hardware can report is the
# mode itself: a folded 2-in-1 is held portrait, an open one landscape. When
# iio-sensor-proxy publishes an accelerometer, its reading wins, because it
# tracks how the device is actually being held.
ORIENTATION="${1:-auto}"

INTERNAL=$(omarchy-hyprland-monitor-laptop)
[[ -n $INTERNAL ]] || exit 0

transform_for_accelerometer() {
  local reading
  # iio-sensor-proxy publishes the accelerometer on the system bus; some
  # builds put it on the session bus instead.
  for bus in --system --session; do
    reading=$(gdbus call "$bus" --dest net.hadess.SensorProxy \
      --object-path /net/hadess/SensorProxy \
      --method net.hadess.SensorProxy.GetAccelerometer 2>/dev/null) && break
  done
  [[ $reading == "("*","*")" ]] || return 1

  local x y z
  x=$(sed -E 's/^\(([-0-9.]+),.*/\1/' <<<"$reading")
  y=$(sed -E 's/^\([-0-9.]+, ([-0-9.]+),.*/\1/' <<<"$reading")
  z=$(sed -E 's/^\([-0-9.]+, [-0-9.]+, ([-0-9.]+)\).*/\1/' <<<"$reading")
  [[ -n $x && -n $y && -n $z ]] || return 1

  # The accelerometer reads in g, with the screen facing up as +z.
  awk -v x="$x" -v y="$y" -v z="$z" 'BEGIN {
    if (z < -0.7) { print 2; exit }
    if ((x < 0 ? -x : x) > (y < 0 ? -y : y)) { print (x > 0 ? 1 : 3); exit }
    print 0
  }'
}

transform_for_mode() {
  [[ $1 == tablet ]] && echo 1 || echo 0
}
case "$ORIENTATION" in
  portrait) transform=1 ;;
  landscape) transform=0 ;;
  auto)
    mode=$(omarchy-2in1-mode)
    if [[ $mode == unknown ]]; then
      # Nothing is known about the orientation, so the panel stays as it is.
      exit 0
    fi
    transform=$(transform_for_accelerometer) || transform=$(transform_for_mode "$mode")
    ;;
  *)
    echo "Usage: omarchy-2in1-rotate [portrait|landscape|auto]" >&2
    exit 1
    ;;
esac

[[ $transform =~ ^[0-3]$ ]] || exit 0

# A monitor rule replaces the whole entry for its output, so the rule has to
# carry the resolution, position and scale the panel is already running at.
# Only the transform changes; everything else is read back and reapplied.
read -r mode position scale <<<"$(hyprctl monitors all -j | jq -r --arg internal "$INTERNAL" '
  .[] | select(.name == $internal) |
  "\([.width, .height] | max)x\([.width, .height] | min)@\(.refreshRate | floor) \(.x)x\(.y) \(.scale)"
')"

[[ -n $mode && -n $position && -n $scale ]] || exit 0

hyprctl eval "hl.monitor({ output = \"$INTERNAL\", mode = \"$mode\", position = \"$position\", scale = $scale, transform = $transform })" >/dev/null 2>&1 || true

# Touch coordinates are reported in the display's own orientation, so the
# touch layer has to be transformed the same way the panel is.
hyprctl eval "hl.config({ input = { touchdevice = { transform = $transform } } })" >/dev/null 2>&1 || true
