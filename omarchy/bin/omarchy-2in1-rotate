#!/bin/bash

# omarchy:summary=Rotate the built-in display for the 2-in-1's current mode
# omarchy:args=[portrait|landscape|auto|watch]
# omarchy:hidden=true

# Only tablet mode follows the accelerometer; laptop mode stays upright.
ORIENTATION="${1:-auto}"

if [[ $ORIENTATION == "watch" ]]; then
  exec {sensor_fd}< <(exec stdbuf -oL monitor-sensor --accel)
  sensor_pid=$!
  trap 'kill "$sensor_pid" 2>/dev/null || true; wait "$sensor_pid" 2>/dev/null || true' EXIT
  trap 'exit 0' INT TERM
  while IFS= read -r line <&"$sensor_fd"; do
    case "$line" in
      *"Has accelerometer"* | *"Accelerometer orientation changed:"*) "$0" auto ;;
    esac
  done
  exit 0
fi

INTERNAL=$(omarchy-hyprland-monitor-laptop)
[[ -n $INTERNAL ]] || exit 0

transform_for_accelerometer() {
  local reading
  reading=$(busctl --system get-property net.hadess.SensorProxy /net/hadess/SensorProxy \
    net.hadess.SensorProxy AccelerometerOrientation 2>/dev/null) || return 1
  case "$reading" in
    's "normal"') echo 0 ;;
    's "left-up"') echo 1 ;;
    's "bottom-up"') echo 2 ;;
    's "right-up"') echo 3 ;;
    *) return 1 ;;
  esac
}

case "$ORIENTATION" in
  portrait) transform=1 ;;
  landscape) transform=0 ;;
  auto)
    case "$(omarchy-2in1-mode)" in
      laptop) transform=0 ;;
      tablet) transform=$(transform_for_accelerometer) || exit 0 ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    echo "Usage: omarchy-2in1-rotate [portrait|landscape|auto|watch]" >&2
    exit 1
    ;;
esac

[[ $transform =~ ^[0-3]$ ]] || exit 0

# Monitor rules replace the whole entry, so resolution, position and scale
# are read back off the panel and reapplied with only the transform changed.
read -r mode position scale <<<"$(hyprctl monitors all -j | jq -r --arg internal "$INTERNAL" '
  .[] | select(.name == $internal) |
  "\([.width, .height] | max)x\([.width, .height] | min)@\(.refreshRate) \(.x)x\(.y) \(.scale)"
')"

[[ -n $mode && -n $position && -n $scale ]] || exit 0

hyprctl eval "hl.monitor({ output = \"$INTERNAL\", mode = \"$mode\", position = \"$position\", scale = $scale, transform = $transform })" >/dev/null || exit 1

# Touch input follows the panel's orientation.
hyprctl eval "hl.config({ input = { touchdevice = { transform = $transform } } })" >/dev/null
