#!/bin/bash

# omarchy:summary=Prune expired packages from the DNF cache
# omarchy:requires-sudo=true

set -e

echo -e "\e[32m\nPrune package cache\e[0m"
if (( EUID == 0 )); then
  dnf clean packages >/dev/null 2>&1 || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
else
  sudo dnf clean packages >/dev/null 2>&1 || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
fi
echo
