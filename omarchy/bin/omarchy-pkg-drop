#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

installed=()
declare -A installed_exact=()
declare -A selected=()

if ! installed_packages=$(rpm -qa --qf '%{NAME}\n'); then
  echo "Unable to query installed packages; no packages were removed." >&2
  exit 1
fi

while IFS= read -r package_name; do
  if [[ -n $package_name ]]; then
    installed_exact[$package_name]=1
  fi
done <<< "$installed_packages"

candidates_for() {
  echo "$1"
  case "$1" in
    brave-bin) echo brave-browser ;;
    brave-origin-bin) echo brave-origin-browser ;;
    microsoft-edge-stable-bin) echo microsoft-edge-stable ;;
    zen-browser-bin) echo zen-browser ;;
    google-chrome) echo google-chrome-stable ;;
    visual-studio-code-bin) echo code ;;
    sublime-text-4) echo sublime-text ;;
    libreoffice-fresh)
      echo libreoffice-writer
      echo libreoffice-core
      ;;
    github-cli) echo gh ;;
    mise-bin) echo mise ;;
    nordvpn-bin) echo nordvpn ;;
    libfprint-git) echo libfprint ;;
    voxtype) echo voxtype-bin ;;
    voxtype-bin) echo voxtype ;;
    python-terminaltexteffects) echo ttfx ;;
    libpulse) echo pulseaudio-libs ;;
    vulkan-intel | vulkan-radeon | vulkan-freedreno) echo mesa-vulkan-drivers ;;
    intel-media-driver) echo libva-intel-media-driver ;;
    libva-intel-driver) echo intel-vaapi-driver ;;
    vpl-gpu-rt) echo intel-vpl-gpu-rt ;;
    sof-firmware) echo alsa-sof-firmware ;;
    pipewire-libcamera) echo pipewire-plugin-libcamera ;;
    pipewire-pulse) echo pipewire-pulseaudio ;;
    pipewire-jack) echo pipewire-jack-audio-connection-kit ;;
    gst-plugin-pipewire) echo pipewire-gstreamer ;;
    pam-u2f) echo pam_u2f ;;
    broadcom-wl-dkms) echo broadcom-wl ;;
    v4l2loopback-dkms) echo v4l2loopback ;;
    ffmpeg) echo ffmpeg-free ;;
    docker) echo moby-engine ;;
    fd) echo fd-find ;;
    nvim) echo neovim ;;
    tobi-try) echo try ;;
    imagemagick) echo ImageMagick ;;
    networkmanager) echo NetworkManager ;;
    python-gobject) echo python3-gobject ;;
    python-poetry-core) echo python3-poetry-core ;;
    tesseract-data-eng) echo tesseract-langpack-eng ;;
    woff2-font-awesome | fontawesome-fonts)
      echo fontawesome-fonts-web
      echo fontawesome-fonts-all
      ;;
  esac
}

for pkg in "$@"; do
  if [[ $pkg == "obsidian" ]] && flatpak info md.obsidian.Obsidian &>/dev/null; then
    flatpak uninstall -y md.obsidian.Obsidian || true
  fi
  while IFS= read -r candidate; do
    if [[ -n ${installed_exact[$candidate]:-} && -z ${selected[$candidate]:-} ]]; then
      installed+=("$candidate")
      selected[$candidate]=1
    fi
  done < <(candidates_for "$pkg")
done

if (( ${#installed[@]} > 0 )); then
  if (( EUID == 0 )); then
    dnf remove -y -- "${installed[@]}"
  else
    sudo dnf remove -y -- "${installed[@]}"
  fi
fi
