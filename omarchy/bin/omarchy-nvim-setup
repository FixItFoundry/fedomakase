#!/bin/bash
# Setup/refresh script for omarchy-nvim on Fedora
#
# omarchy-nvim-setup: install missing config/data for the current user.
# omarchy-nvim-refresh: back up existing config, reset cached data, and copy
#                       the skel-seeded Omarchy Neovim defaults again.

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
SKEL_CONFIG_DIR="/etc/skel/.config/nvim"
SKEL_DATA_DIR="/etc/skel/.local/share/nvim"
PACKAGE_DIR="/usr/share/omarchy-nvim"
CONFIG_SOURCE_DIR="$SKEL_CONFIG_DIR"
DATA_SOURCE_DIR="$SKEL_DATA_DIR"
CONFIG_DIR="${HOME}/.config/nvim"
DATA_DIR="${HOME}/.local/share/nvim"
STATE_DIR="${HOME}/.local/state/nvim"
CACHE_DIR="${HOME}/.cache/nvim"

command_name="$(basename "$0")"
refresh=false

if [[ $command_name == "omarchy-nvim-refresh" ]]; then
  refresh=true
fi

while (( $# > 0 )); do
  case "$1" in
    --force|--refresh)
      refresh=true
      ;;
    -h|--help)
      cat <<'EOF'
Usage: omarchy-nvim-setup [--force]
       omarchy-nvim-refresh

omarchy-nvim-setup installs Omarchy's skel-seeded Neovim config/data only when
missing. omarchy-nvim-refresh backs up an existing config and overwrites it with
the skel-seeded defaults.
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

if [[ ! -d "$CONFIG_SOURCE_DIR" ]]; then
  if [[ -d "$PACKAGE_DIR/config" ]]; then
    CONFIG_SOURCE_DIR="$PACKAGE_DIR/config"
  elif [[ -d "$OMARCHY_PATH/default/nvim" ]]; then
    CONFIG_SOURCE_DIR="$OMARCHY_PATH/default/nvim"
  fi
fi

if [[ ! -d "$CONFIG_SOURCE_DIR" ]]; then
  echo "Error: omarchy-nvim defaults not found in $CONFIG_SOURCE_DIR." >&2
  exit 1
fi

backup_path() {
  local path="$1"
  local backup="${path}.backup.$(date +%Y%m%d-%H%M%S)"

  if [[ -e $path || -L $path ]]; then
    echo "Backing up $path to $backup"
    mv "$path" "$backup"
  fi
}

copy_tree() {
  local src="$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"
  cp -a "$src" "$dest"
}

install_config() {
  if [[ -d "$CONFIG_DIR" && $refresh != true ]]; then
    echo "Neovim config already exists at $CONFIG_DIR; leaving it in place."
    return
  fi

  backup_path "$CONFIG_DIR"
  copy_tree "$CONFIG_SOURCE_DIR" "$CONFIG_DIR"
  echo "Installed Neovim config to $CONFIG_DIR"
}

install_data() {
  if [[ -d "$DATA_DIR/lazy" && $refresh != true ]]; then
    echo "Neovim data already exists at $DATA_DIR; leaving it in place."
    return
  fi

  if [[ $refresh == true ]]; then
    rm -rf "$DATA_DIR" "$CACHE_DIR" "$STATE_DIR"
  fi

  if [[ -d "$DATA_SOURCE_DIR" ]]; then
    copy_tree "$DATA_SOURCE_DIR" "$DATA_DIR"
    echo "Installed Neovim data to $DATA_DIR"
  elif command -v nvim &>/dev/null; then
    echo "Syncing LazyVim plugins for $CONFIG_DIR..."
    nvim --headless "+Lazy! sync" "+qa!" 2>/dev/null || true
  fi
}

install_config
install_data

if (( EUID == 0 )); then
  target_user="${SUDO_USER:-${USER:-root}}"
  if [[ $target_user != "root" ]]; then
    chown -R "${target_user}:${target_user}" "$CONFIG_DIR" "$DATA_DIR" 2>/dev/null || true
  fi
fi

theme_dir=".local/state/omarchy/current/theme"
if [[ ! -d "$HOME/.local/state/omarchy/current" ]]; then
  omarchy_version=$(cat "${OMARCHY_PATH:-$HOME/.local/share/omarchy}/version" 2>/dev/null || true)
  if [[ -d "$HOME/.config/omarchy/current" || ${omarchy_version%%.*} == "3" ]]; then
    theme_dir=".config/omarchy/current/theme"
  fi
fi
mkdir -p "${CONFIG_DIR}/lua/plugins"
ln -snf "../../../../${theme_dir}/neovim.lua" "${CONFIG_DIR}/lua/plugins/theme.lua"

if [[ -d "$DATA_DIR/lazy" ]]; then
  for dir in "$DATA_DIR"/lazy/*/; do
    if [[ -d "$dir/.git" ]]; then
      git --git-dir="$dir/.git" --work-tree="$dir" restore . 2>/dev/null || true
    fi
  done
fi

for mime in \
  text/plain text/english text/x-makefile text/x-c++hdr text/x-c++src \
  text/x-chdr text/x-csrc text/x-java text/x-moc text/x-pascal \
  text/x-tcl text/x-tex application/x-shellscript text/x-c text/x-c++ \
  application/xml text/xml; do
  xdg-mime default nvim.desktop "$mime" 2>/dev/null || true
done

if [[ $refresh == true ]]; then
  echo "Neovim refresh complete!"
else
  echo "Neovim setup complete!"
fi
