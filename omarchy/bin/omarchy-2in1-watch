#!/bin/bash

# omarchy:summary=Follow the tablet-mode orientation switch
# omarchy:hidden=true

# The orientation switch is the trigger: when it moves, the session's mode
# moves with it. Manual overrides apply themselves through omarchy-2in1-apply
# and win over the hardware, so this watcher does nothing with them.

LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-2in1-watch.lock"
TABLET_MODE="$OMARCHY_PATH/default/input/tablet-mode.py"

exec 9>"$LOCK"
flock -n 9 || exit 0

if ! /usr/bin/python3 "$TABLET_MODE" supported; then
  exit 0
fi

# The helper must not hold the lock: it outlives this script and would block
# any future watcher for good. The applying loop holds it instead.
/usr/bin/python3 "$TABLET_MODE" watch 9>&- | while IFS= read -r mode; do
  omarchy-2in1-apply "$mode" >/dev/null 2>&1 || true
done
