#!/bin/bash

# omarchy:summary=Switch the 2-in-1 between tablet and laptop mode by hand
# omarchy:args=[tablet|laptop|auto|toggle]

# The kernel never reports folding on some 2-in-1s, so the mode is set by
# hand; "auto" hands control back to the hardware. A switch applies right
# away; the watcher is only for the orientation switch itself.

STATE_DIR="$HOME/.local/state/omarchy/2in1"
OVERRIDE_FILE="$STATE_DIR/mode"
ACTION="${1:-toggle}"

current() {
  omarchy-2in1-mode
}

set_mode() {
  local mode="$1"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$mode" >"$OVERRIDE_FILE"
  omarchy-2in1-apply "$mode"
  echo "$mode"
}

clear_mode() {
  rm -f "$OVERRIDE_FILE"
  omarchy-2in1-apply "$(omarchy-2in1-mode)"
  echo auto
}

case "$ACTION" in
  tablet | laptop) set_mode "$ACTION" ;;
  auto) clear_mode ;;
  toggle)
    if [[ $(current) == tablet ]]; then
      set_mode laptop
    else
      set_mode tablet
    fi
    ;;
  *)
    echo "Usage: omarchy-toggle-2in1 [tablet|laptop|auto|toggle]" >&2
    exit 1
    ;;
esac
