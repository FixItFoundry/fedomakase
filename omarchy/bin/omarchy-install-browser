#!/bin/bash

# omarchy:summary=Install a supported browser
# omarchy:args=<chromium|chrome|brave|brave-origin|edge|firefox|zen>
# omarchy:examples=omarchy install browser chromium | omarchy install browser firefox

set -e

source "$OMARCHY_PATH/install/helpers/browser-policy.sh"

opt_path="${OMARCHY_OPT_PATH:-/opt}"

setup_chromium_policy_directory() {
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

# The widevine package registers its CDM for Chromium and Firefox only; Brave
# looks for one in its own install directory.
link_widevine_cdm() {
  local cdm="$opt_path/WidevineCdm/chromium"
  local install_dir="$opt_path/$1"

  if [[ -d $cdm && -d $install_dir && ! -e $install_dir/WidevineCdm ]]; then
    as_root ln -sfn "$cdm" "$install_dir/WidevineCdm"
  fi
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$OMARCHY_PATH/config/chromium-flags.conf" "$1"
  omarchy-install-chromium-copy-url
  omarchy-install-chromium-ytdlp
  omarchy-install-video-decode
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/omarchy-firefox-wayland.conf
}

case $1 in
chromium)
  echo "Installing Chromium..."
  omarchy-pkg-add chromium

  setup_chromium_policy_directory /etc/chromium/policies/managed
  copy_chromium_flags ~/.config/chromium-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install chromium
  announce_browser_installed "Chromium"
  ;;
chrome)
  echo "Installing Chrome..."
  omarchy-pkg-add google-chrome || exit 1

  setup_chromium_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install chrome
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  sudo dnf config-manager addrepo --from-repofile=https://packages.microsoft.com/yumrepos/edge/config.repo 2>/dev/null ||
    sudo dnf config-manager --add-repo https://packages.microsoft.com/yumrepos/edge 2>/dev/null || true
  sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc 2>/dev/null || true
  omarchy-pkg-add microsoft-edge-stable || exit 1

  setup_chromium_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install edge
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  sudo dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo 2>/dev/null ||
    sudo dnf config-manager --add-repo https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo 2>/dev/null || true
  sudo rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc 2>/dev/null || true
  omarchy-pkg-add brave-browser || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  link_widevine_cdm brave.com/brave
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install brave
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Brave Origin is not available on Fedora. Install standard Brave instead."
  exit 1
  ;;
firefox)
  echo "Installing Firefox..."
  omarchy-pkg-add firefox

  browser_policy_setup_firefox_distribution /usr/lib64/firefox/distribution
  setup_firefox_wayland
  omarchy-lifecycle-dispatch post-install firefox
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  sudo dnf copr enable -y refi64/zen-browser 2>/dev/null || true
  omarchy-pkg-add zen-browser || exit 1

  browser_policy_setup_firefox_distribution /opt/zen-browser/distribution
  setup_firefox_wayland
  omarchy-lifecycle-dispatch post-install zen
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: omarchy-install-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
