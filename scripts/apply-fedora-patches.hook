#!/bin/bash

set -e

# Re-apply Fedora patches after every upstream Omarchy update.
#
# Durability: upstream updates can replace /usr/share/omarchy wholesale,
# destroying bin/omarchy-apply-fedora-patches and fedora-patches/.
# The canonical copies therefore live in the user-land stash
# (~/.local/share/fedomakase/, installed by scripts/apply.sh) and are
# restored into place before running.

STASH="$HOME/.local/share/fedomakase"
OMARCHY="${OMARCHY_PATH:-/usr/share/omarchy}"
RUNNER="$OMARCHY/bin/omarchy-apply-fedora-patches"

if [[ ! -x $RUNNER ]]; then
  if [[ ! -x $STASH/bin/omarchy-apply-fedora-patches ]]; then
    echo "fedomakase: no patch runner found (run scripts/apply.sh once)" >&2
    exit 1
  fi
  mkdir -p "$OMARCHY/bin" "$OMARCHY/fedora-patches"
  cp "$STASH/bin/"* "$OMARCHY/bin/"
  cp "$STASH/fedora-patches/"* "$OMARCHY/fedora-patches/"
  chmod +x "$OMARCHY/bin/"*
fi

# Re-sync payload-owned files first: upstream updates replace these wholesale
# and the sed runner cannot reconstruct them. The stash is the durable source.
if [[ -d $STASH/payload/bin ]]; then
  echo "fedomakase: re-syncing payload helpers from stash..."
  if (( EUID == 0 )); then
    cp "$STASH/payload/bin/"* "$OMARCHY/bin/"
    cp "$STASH/payload/install/"* "$OMARCHY/install/"
    cp "$STASH/payload/etc/sddm.conf.d/10-wayland.conf" "$OMARCHY/etc/sddm.conf.d/10-wayland.conf"
    chmod +x "$OMARCHY/bin/"*
  else
    sudo cp "$STASH/payload/bin/"* "$OMARCHY/bin/"
    sudo cp "$STASH/payload/install/"* "$OMARCHY/install/"
    sudo cp "$STASH/payload/etc/sddm.conf.d/10-wayland.conf" "$OMARCHY/etc/sddm.conf.d/10-wayland.conf"
    sudo chmod +x "$OMARCHY/bin/"*
  fi
fi

if (( EUID == 0 )); then
  "$RUNNER"
else
  sudo "$RUNNER"
fi
